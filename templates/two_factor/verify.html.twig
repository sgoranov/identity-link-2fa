{% extends 'base.html.twig' %}

{% block javascripts %}
    {% block importmap %}
        {{ importmap('verify') }}
    {% endblock %}
{% endblock %}

{% block content %}
    <div class="container mx-auto max-w-md p-4 bg-white rounded-lg shadow-md text-center">

        <h1 class="text-xl sm:text-2xl font-bold mb-4 break-words">
            {{ 'two_factor.title'|trans }}
        </h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-danger" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <p class="mb-4 text-sm sm:text-base break-words">
            {{ 'two_factor.instructions'|trans }}
        </p>

        <div class="mb-6">
            {{ form_start(form, {'attr': {'id': 'tfa-form'}}) }}
            {{ form_row(form.code, {
                'label': false,
                'attr': {
                    'class': 'd-none',
                    'id': 'real-tfa-input'
                }
            }) }}
            {{ form_end(form) }}

            <div class="d-flex justify-content-center gap-2 gap-sm-3 mb-4">
                <input type="text" class="form-control form-control-lg otp-field" maxlength="1" pattern="[0-9]*" inputmode="numeric" autocomplete="one-time-code">
                <input type="text" class="form-control form-control-lg otp-field" maxlength="1" pattern="[0-9]*" inputmode="numeric">
                <input type="text" class="form-control form-control-lg otp-field" maxlength="1" pattern="[0-9]*" inputmode="numeric">
                <input type="text" class="form-control form-control-lg otp-field" maxlength="1" pattern="[0-9]*" inputmode="numeric">
                <input type="text" class="form-control form-control-lg otp-field" maxlength="1" pattern="[0-9]*" inputmode="numeric">
                <input type="text" class="form-control form-control-lg otp-field" maxlength="1" pattern="[0-9]*" inputmode="numeric">
            </div>

            <button type="button" id="submit-btn" class="btn btn-primary btn-lg w-50 mb-3" disabled>
                {{ 'two_factor.verify_button'|trans }}
            </button>

        </div>
    </div>
{% endblock %}
