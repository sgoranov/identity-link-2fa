{% extends 'base.html.twig' %}

{% block content %}
    <div class="container mx-auto max-w-md p-4 bg-white rounded-lg shadow-md text-center">

        <h1 class="text-xl sm:text-2xl font-bold mb-4 break-words">
            {{ 'two_factor.title'|trans }}
        </h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-danger" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <p class="mb-4 text-sm sm:text-base break-words">
            {{ 'two_factor.instructions'|trans }}
        </p>

        <div class="mb-6">
            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
            {{ form_row(form.code, {
                'label': false,
                'attr': {
                    'class': 'w-full border rounded-lg px-4 py-2 text-center text-lg focus:ring-2 focus:ring-blue-500'
                }
            }) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
